# Supabase project settings → API Keys (use the publishable key, sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of the site, used for canonical links, sitemaps and share previews
NEXT_PUBLIC_SITE_URL=https://truth.example.co.za

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Supabase project settings → API Keys → Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=
# Paystack dashboard → Settings → API Keys & Webhooks (sk_test_... while testing)
PAYSTACK_SECRET_KEY=
